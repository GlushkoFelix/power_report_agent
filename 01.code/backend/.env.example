# ============================================================================
# 智电析报 · 后端环境变量样例
# ----------------------------------------------------------------------------
# 用法：复制本文件为 `.env` 并填入真实值。
# 安全：`.env` 已在 `.gitignore` 中排除，**严禁提交到版本库**（PRD 6.5）。
# 路径：库路径以「项目根」为基准解析（项目根 = 01.code 的上一级目录），
#       因此从任意目录启动 uvicorn / IDE 直接运行都能正确连库。
# 口径：本文件只管环境与路径；峰平谷时段、异常阈值等口径常量见 PRD 8.4 / 8.10。
# ============================================================================

# ── LLM：任意 OpenAI 兼容厂商（默认阿里云百炼）───────────────────────────────
# 客户端只依赖 OpenAI 兼容协议（POST {LLM_BASE_URL}/chat/completions + Bearer Key），
# **换厂商只改本区块，代码零改动**。四个变量：
#   LLM_API_KEY          必填（正式名）；兼容旧名 DASHSCOPE_API_KEY（两者取其一，同时填以 LLM_API_KEY 优先）
#   LLM_BASE_URL         该厂商的 OpenAI 兼容端点（注意含 /v1 之类路径，以厂商文档为准）
#   LLM_MODEL_MAIN/LIGHT 主力模型（生成 SQL/代码、解读）与轻量模型（slot 抽取）；
#                        厂商只有单模型时两个填同一个名字即可
#   LLM_PROVIDER_LABEL   厂商标识，仅用于 /system/health 展示与日志（不影响协议行为）
LLM_API_KEY=sk-xxxxxx
LLM_PROVIDER_LABEL=dashscope
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_MAIN=qwen-max
LLM_MODEL_LIGHT=qwen-turbo
#   注（2026-10-14）：**轻量档同时服务"解读"阶段**——`narrative` 已改为走轻量档
#   （生成用 MAIN 保准确率，解读用 LIGHT 求快与稳）。故 LIGHT 请选**输出节制、JSON 稳定**的模型：
#   实测教训：把主力"推理型"模型用在解读上会"推理洪水"（completion 165 → 2,536、正文解析失败→界面无解读）。
#   本项目当前取值（2026-10-16 更新）：MAIN=`deepseek-v4-flash-0731`（生成；端点在 10-16 把
#   `deepseek-v4.1-flash` 换代成这个别名，响应 model 字段仍回旧名 ⇒ 上游同一模型、历史成绩可比）、
#   LIGHT=`deepseek-v4-flash-0731`（slot）。**换端点/额度后先 `GET {base_url}/models` 对一遍清单**
#   （否则会直接 503 model_not_found）。
# ⚠️ **解读请用下面这行单独配**（2026-10-14 事故教训）：把解读塞进 LIGHT 会让"换解读模型=换 slot 模型"，
#   一旦 slot 行为变化，问题定位会多一个无关变量。本项目的解读模型实测选型：`qwen3.8-flash`
#   （2026-10-16 换：原 `glm-5.3-flash` 在同一端点 JSON/纯文本**两种模式都返回空正文**且照扣 token；
#   `qwen3.8-flash` 实测 2.9–3.7s、正文正常。主力"推理型"模型在解读上会"推理洪水"：completion 165 → 2,536、正文解析失败）。
# 解读专用模型（留空 = 回落 LLM_MODEL_LIGHT）
LLM_MODEL_NARRATIVE=
LLM_TEMPERATURE=0.0
# 解读阶段软超时（秒）：超时或解析失败 → 改用「自动摘要」（服务端用结果表算出的结论，正文标注来源），
# 界面**永远有解读**；表格与图表早已产出、不受影响。产品默认 8 s（= 代码默认，可不动）。
NARRATIVE_TIMEOUT_SECONDS=8
# 生成阶段**软超时**（秒）——生成不能像解读那样"跳过"，超时即按 `E_LLM` **失败**留痕。
# ⚠️ 取值教训（`P-038`，两次踩坑）：聚合端点在**慢时段**单次生成要 15–25 s+，上限一被触发就是**整题失败**，
# 于是正确率读数被时段压低（不是模型变差）。本项目因此两次上调：25 → 40（2026-10-14）→ **60（2026-10-16）**；
# 代价是慢时段单题最坏要等更久（伤 P95）。**代码默认是 25**，这里显式写 60 是本项目的调优值。
GENERATE_TIMEOUT_SECONDS=60
# 思考开关（`enable_thinking`）——**本项目最终口径：发送 `false`**（见下"两轮相反结论"）。
# ⚠️ 但请务必先读完整段再决定：同一个参数在本端点形成了**两次相反结论**——
# 历史：推理型模型（Qwen3 等）默认输出思考过程，实测开销极大（4.0s/195 tokens vs 关闭后 0.9s/5 tokens），
#       故一度默认发 `false` 关闭。
# ⚠️ **2026-10-14 反转（真实探针实测）**：某些聚合端点收到"关闭思考"后会**另行注入约 328 token 的系统提示**
#    （同一请求 prompt 200 → 528 token），并让思考继续抢占输出额度：解读形态请求实测
#      发该字段 → avg 4.88s（最慢 9.78s）、3 次里 1 次正文 0 字符
#      不发     → avg 2.42s（最慢 2.49s）、3/3 正文正常
#    真实后果：narrative 用 636 token 的 prompt 却烧掉 1,945 completion token、15.4s，落库正文为空。
# ⇒ **换端点/模型后必须用真探针复测**（`02.data/tmp/_latency_probe3.py` 可复用），别照抄结论；
#   若你的端点确实支持关闭思考，再取消下一行注释。
#LLM_ENABLE_THINKING=false
# 输出上限（0 = 不发送）
# 2026-10-13 由 2048 调到 4096：推理型模型的**思考会先占用输出额度**，
# 2048 对"多指标 + 长解读"的题有 JSON 被截断风险（截断会报 E_LLM）；上限只约束"允许输出多长"，不增加实际花费。
# 2026-10-14 再由 4096 上调到 8192：A/B 复测显示"思考先占额度"会把正文挤掉——
# 实测某题生成 completion=4095（正好顶到 4096）被截断 → JSON 不完整 → 列数/取值错。
# 上限只约束"允许输出多长"，不改变正常消耗。
LLM_MAX_TOKENS=8192
# 少数端点不认 response_format（JSON 模式）会直接 400 → 自动去参重试一次；置 false 可关闭
LLM_JSON_MODE_FALLBACK=true

# ── 其他厂商示例（取消注释并按需替换上面的 LLM_* 四项）───────────────────────
# DeepSeek：
#   LLM_API_KEY=sk-xxx
#   LLM_PROVIDER_LABEL=deepseek
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL_MAIN=deepseek-chat
#   LLM_MODEL_LIGHT=deepseek-chat
# Moonshot（Kimi）：
#   LLM_PROVIDER_LABEL=moonshot
#   LLM_BASE_URL=https://api.moonshot.cn/v1
#   LLM_MODEL_MAIN=kimi-k2-0905-preview
#   LLM_MODEL_LIGHT=moonshot-v1-8k
# 智谱 GLM：
#   LLM_PROVIDER_LABEL=zhipu
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   LLM_MODEL_MAIN=glm-4-plus
#   LLM_MODEL_LIGHT=glm-4-flash
# 本地 Ollama / vLLM（离线演示、不消耗 token）：
#   LLM_PROVIDER_LABEL=ollama
#   LLM_BASE_URL=http://127.0.0.1:11434/v1
#   LLM_MODEL_MAIN=qwen2.5:7b-instruct
#   LLM_MODEL_LIGHT=qwen2.5:7b-instruct
# 阿里云百炼 MaaS 专属端点（形如 https://llm-xxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1）：
#   LLM_BASE_URL=<专属端点>/compatible-mode/v1
#   LLM_MODEL_MAIN=<该端点下可用模型名>      # 专属部署的模型名以控制台为准
# 说明：不配置 LLM_API_KEY 时，后端自动使用**离线脚本模型**（链路可跑通、结果非真实模型产出），
#       `/system/health` 会如实回报 llm.configured=false；Anthropic / Gemini 原生协议不在支持范围（需独立适配）。

# ── 鉴权（JWT）──────────────────────────────────────────────────────────────
# JWT_SECRET_KEY 必须显式配置：缺失则后端**启动报错**（避免每次重启换密钥导致已签发 token 全部失效）。
# 生成命令：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=请填入
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ── 编排方式（LangGraph 接入的灰度开关）─────────────────────────────────────
# langgraph = app/agent/graph.py 的 StateGraph（**默认**）：13 节点 + 条件边，
#             含会话级检查点（checkpoints / writes）与澄清 Human-in-the-loop（interrupt → resume）。
# legacy    = services/analysis_service.run_once（显式 async 编排，保留为回退路径）。
# 两条路径由 tests/test_langgraph_parity.py（9 条）逐字段 + 逐事件保证等价；回退只需改本行并重启。
ORCHESTRATOR=langgraph

# ── 规则快通道 v2（**默认开**；2026-10-16 真模型评测确认后转正）──────────────
# 开关："能由规则唯一确定"的问法直接产出 slot、省掉一次模型往返（约 1.5–5.5s）。
# true  = v2 规则（结构化解拦 + 分组维度抽取 + 多指标放行 + 指标词表加固，题库 63/135 轮）；
# false = 既有规则（题库 19/135 轮），**一字回退**到历史口径与历史成绩。
# 收益是"少一次调用"而非"提正确率"：0 额度评估见 `02.data/tmp/_rules_proto_eval.md`，
# 落地守卫见 `01.code/backend/tests/test_slot_fastpath_v2.py`（零回退 / 消融矩阵 / 边界）。
# 真模型转正依据见 `02.data/tmp/_a_report.md`（靶向组零退化 + 20 题省 10 次 slot LLM）。
# ⚠️ 成绩引用需带"含规则快通道 v2"，不能直接与历史读数比。改完重启即生效、可一键回退。
SLOT_FASTPATH_V2=true

# ── 应用 ────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
# 解读阶段超时上限（秒）。产品默认 8.0（超时跳过解读，表格与图表照给）。
# 2026-10-14 经验：**端点对同一提示词的行为会逐日漂移**——同一模型/提示词，narrative 的 completion
#   昨天 165、今天 2,536（耗时 5.9s → 15–18s，且正文解析失败→界面无解读）。
#   保持 8s 既能兜住坏时段，又不会让"没解读"变成单题多等 20 秒。
# 演示需要更长解读时可临时放宽（代价：单题最多多等）。
# NARRATIVE_TIMEOUT_SECONDS=8
# 补充（2026-10-14）：**解读永不空白** —— 超时或解析失败时，服务端会用结果表生成「自动摘要」
#   （正文以"自动摘要："开头并注明来源，`anomalies` 里说明原因）；解读是增值项，
#   它的失败**不会**让整题失败（表格与图表早已产出）。
# 生成阶段**软超时**（秒）。生成是主链路的关键调用，不能像解读那样"跳过"，超时按失败处理（E_LLM）。
# 2026-10-14 定稿 **40**（原 25）：端点慢时段里 19/120 题在 33–37s 撞 25s 上限而**整题失败**，
#   同 19 题重跑（无任何改动）18 题通过 ⇒ **上限只在慢时段被触发、一触发就丢题**；
#   快时段零成本（上限是天花板）。配套：`SLOT_TIMEOUT_SECONDS` 同期由 12 → 20（代码常量）。
# GENERATE_TIMEOUT_SECONDS=40

# ── 数据库（相对项目根；写绝对路径亦可）──────────────────────────────────────
# reports.db      数据面：报表数据，应用侧只读（PRAGMA query_only）
#                 例外：上传入库服务用受控写连接（mode=rw + BEGIN IMMEDIATE）写入动态表
# power_agent.db  控制面：用户 / 会话 / 分析记录 / 评测，读写
REPORTS_DB_PATH=02.data/reports.db
POWER_AGENT_DB_PATH=02.data/power_agent.db

# ── 上传写路径（PRD F1.1 / F1.3）────────────────────────────────────────────
# 落盘目录按 {user_id}/{report_code}/ 隔离；UPLOAD_MAX_MB 为单文件上限（超限返回 413）
# UPLOAD_PENDING_TTL_HOURS：已解析未确认（pending）的上传存活时长，超时由惰性清理回收
# INGEST_BATCH_ROWS：灌数分批提交行数（切碎写锁持有时间）
UPLOAD_DIR_PATH=02.data/uploads
UPLOAD_MAX_MB=200
UPLOAD_PENDING_TTL_HOURS=24
INGEST_BATCH_ROWS=50000
